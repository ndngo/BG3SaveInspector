<Window x:Class="BG3SaveInspector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BG3SaveInspector.Converters"
        Title="BG3 Save Inspector" Height="800" Width="1200"
        Background="#1a1a1a">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>
        <!-- HEADER -->
        <Border Grid.Row="0" Background="#111111" Padding="16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Width="80" Height="80" Source="{Binding SaveFile.Thumbnail}"/>
                <StackPanel Margin="16 0 0 0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaveFile.SaveName}" Foreground="White" FontSize="18"/>
                    <TextBlock Text="{Binding SaveFile.LeaderName}" Foreground="White" FontSize="14"/>
                    <TextBlock Text="{Binding SaveFile.Location}" Foreground="#aaaaaa" FontSize="13"/>
                    <TextBlock Text="{Binding SaveFile.Difficulty}" Foreground="#c8a96e" FontSize="12"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border>
            <Button Width="120" Content="{Binding DiffToggleLabel}"
                        Command="{Binding ToggleDiffModeCommand}"
                        Margin="8" Padding="4" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
        </Border>

        <!-- NORMAL MODE -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsDiffMode, Converter={StaticResource InverseBoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Quest list -->
            <Grid Grid.Column="0" Background="#1e1e1e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Load Save" VerticalAlignment="Center" Padding="4"
                        Command="{Binding SaveFile.LoadCommand}"/>
                    <Border Grid.Column="1" Padding="8" Margin="4">
                        <TextBox 
                            Text="{Binding QuestList.SearchText, UpdateSourceTrigger=PropertyChanged}"
                            Background="#2a2a2a" Foreground="White" BorderBrush="#444"/>
                    </Border>
                    <Border Grid.Column="2" Margin="8">
                        <Button  Content="✕"
                            Command="{Binding QuestList.ClearSearchCommand}"
                            Background="Transparent" Foreground="#aaaaaa" BorderThickness="0"/>
                    </Border>
                </Grid>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding QuestList.QuestsView}"
                         SelectedItem="{Binding QuestList.SelectedQuest}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#aaaaaa" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Detail tabs -->
            <TabControl Grid.Column="1" Background="#252525" BorderThickness="0">
                <TabItem Header="Quest">
                    <StackPanel Margin="24"
                                Visibility="{Binding QuestDetail.HasSelection,
                                Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding QuestDetail.ObjectiveId}"
                                   Foreground="White" FontSize="20"/>
                        <TextBlock Text="{Binding QuestDetail.StepId}"
                                   Foreground="#aaaaaa" FontSize="14" Margin="0 8 0 0"/>
                        <TextBlock Text="{Binding QuestDetail.Status}"
                                   Foreground="#c8a96e" FontSize="13" Margin="0 8 0 0"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Party">
                    <ListBox ItemsSource="{Binding SaveFile.Party}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                                        <TextBlock Text="{Binding Race}" Foreground="#aaaaaa" FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- DIFF MODE -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsDiffMode, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Save A panel -->
            <Grid Grid.Column="0" Background="#1e1e1e">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Diff.SaveAName}"
               Foreground="White" Margin="8" FontWeight="Bold"
               VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="1" Content="Load Save A" Margin="8"
                        Command="{Binding Diff.LoadSaveACommand}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8"
                         Text="{Binding Diff.SearchTextA, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2a2a2a" Foreground="White" BorderBrush="#444"/>
                    <Button Grid.Column="2" Content="✕"
                        Command="{Binding Diff.ClearSearchACommand}"
                        Background="Transparent" Foreground="#aaaaaa" BorderThickness="0"/>

                </Grid>
                <ListBox Grid.Row="3"
             ItemsSource="{Binding Diff.SaveAQuestsView}"
             Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Background="{Binding DiffColour}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#aaaaaa" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Save B panel -->
            <Grid Grid.Column="1" Background="#252525">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Diff.SaveBName}"
               Foreground="White" Margin="8" FontWeight="Bold"
               VerticalAlignment="Center"/>
                
                <Grid Grid.Row="1" Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="1" Content="Load Save B" Margin="8"
                        Command="{Binding Diff.LoadSaveBCommand}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="8"
                         Text="{Binding Diff.SearchTextB, UpdateSourceTrigger=PropertyChanged}"
                         Background="#2a2a2a" Foreground="White" BorderBrush="#444"/>
                    <Button Grid.Column="2" Content="✕"
                        Command="{Binding Diff.ClearSearchBCommand}"
                        Background="Transparent" Foreground="#aaaaaa" BorderThickness="0"/>
                </Grid>

                <ListBox Grid.Row="3"
             ItemsSource="{Binding Diff.SaveBQuestsView}"
             Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4" Background="{Binding DiffColour}">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="White"/>
                                    <TextBlock Text="{Binding Status}" Foreground="#aaaaaa" FontSize="11"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#111111" Padding="8 0">
            <TextBlock Foreground="#888888" VerticalAlignment="Center">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} | {1}">
                        <Binding Path="StatusText"/>
                        <Binding Path="Diff.DiffSummary"/>
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
        </Border>
    </Grid>
</Window>