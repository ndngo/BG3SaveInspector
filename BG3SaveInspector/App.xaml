<Application x:Class="BG3SaveInspector.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BG3SaveInspector"
             xmlns:converters="clr-namespace:BG3SaveInspector.Converters"
             StartupUri="MainWindow.xaml">

    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Application.Resources>
</Application>
